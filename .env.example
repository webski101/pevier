# Local setup uses SQLite through an automatically generated local schema.
# Production uses a hosted PostgreSQL URL supplied by the deployment platform.
DATABASE_URL="file:./dev.db"
PEVIER_PUBLISH_MODE="DRY_RUN"

# Optional development-only fallback key. Production agents use an account key
# created in Pevier Settings.
PEVIER_AGENT_KEY=""

# Optional values for the bundled production agent CLI.
PEVIER_URL="http://localhost:3000"
PEVIER_ACCOUNT_KEY=""
PEVIER_AGENT_ID=""
PEVIER_CHANNEL_ID=""

# Base64-encoded 32-byte key used to encrypt OAuth tokens at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PEVIER_ENCRYPTION_KEY=""

# Google identity sign-in. These scopes are limited to openid, email, and profile.
# Use a dedicated OAuth web client; Pevier does not request YouTube access.
GOOGLE_AUTH_CLIENT_ID=""
GOOGLE_AUTH_CLIENT_SECRET=""
GOOGLE_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Instagram API with Instagram Login. Each user connects their own Professional account.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/platforms/instagram/callback"
# In production, replace this with https://YOUR-DOMAIN/api/platforms/instagram/callback
INSTAGRAM_API_VERSION="v24.0"

# Added automatically when a public Vercel Blob store is connected to the project.
# Pevier uses it for short-lived Reel uploads and removes each file after the Meta handoff.
BLOB_READ_WRITE_TOKEN=""
