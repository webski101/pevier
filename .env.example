DATABASE_URL="file:./dev.db"
PEVIER_PUBLISH_MODE="DRY_RUN"

# Optional shared key for external agents. Local development works without one.
# Set this before exposing Pevier beyond localhost.
PEVIER_AGENT_KEY=""

# YouTube OAuth also provides the Pevier user identity. Create a Web application OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/platforms/youtube/callback"
# In production, replace this with https://YOUR-DOMAIN/api/platforms/youtube/callback

# Base64-encoded 32-byte key used to encrypt OAuth tokens at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PEVIER_ENCRYPTION_KEY=""
